{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StartupCradleCompany",
  "type": "object",
  "required": [
    "id",
    "name_zh",
    "name_en",
    "tagline",
    "founded_year",
    "round",
    "region",
    "sector",
    "why_potential",
    "signals",
    "website",
    "listed_at",
    "status"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name_zh": { "type": "string", "minLength": 1 },
    "name_en": { "type": "string", "minLength": 1 },
    "tagline": { "type": "string", "minLength": 1, "maxLength": 120 },
    "founded_year": { "type": ["integer", "null"] },
    "round": { "type": "string", "minLength": 1 },
    "region": { "type": "string", "minLength": 1 },
    "sector": { "type": "string", "minLength": 1 },
    "why_potential": { "type": "string", "minLength": 20 },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "website": { "type": "string", "format": "uri" },
    "repo": { "type": ["string", "null"] },
    "listed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "type": "string", "enum": ["watching", "graduated", "archived"] }
  },
  "additionalProperties": false
}
